{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "harness": {
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      },
      "required": [
        "enabled",
        "scope"
      ],
      "additionalProperties": false
    },
    "manager": {
      "type": "object",
      "properties": {
        "workflow": {
          "default": "harness-manager.yml",
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+\\.ya?ml$"
        },
        "maxActions": {
          "default": 10,
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "timeoutMinutes": {
          "default": 15,
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "maxContextTasks": {
          "default": 20,
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "maxContextChars": {
          "default": 20000,
          "type": "integer",
          "minimum": 1000,
          "maximum": 100000
        },
        "trustedActors": {
          "default": [
            "github-actions[bot]"
          ],
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "workflow",
        "maxActions",
        "timeoutMinutes",
        "maxContextTasks",
        "maxContextChars",
        "trustedActors"
      ],
      "additionalProperties": false
    },
    "autonomy": {
      "type": "object",
      "properties": {
        "profile": {
          "default": "supervised",
          "type": "string",
          "enum": [
            "advisory",
            "supervised",
            "autonomous"
          ]
        },
        "overrides": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": [
              "transition",
              "close_issue",
              "create_followup",
              "prioritize",
              "approve_task",
              "start_worker",
              "retry_worker",
              "cancel_worker",
              "expand_scope",
              "merge_pr"
            ]
          },
          "additionalProperties": {
            "type": "string",
            "enum": [
              "allow",
              "deny",
              "approval"
            ]
          }
        }
      },
      "required": [
        "profile",
        "overrides"
      ],
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "properties": {
        "dryRun": {
          "default": false,
          "type": "boolean"
        },
        "maxParallelWorkers": {
          "default": 1,
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "maxRetries": {
          "default": 2,
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "maxNewIssues": {
          "default": 3,
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "workerTimeoutMinutes": {
          "default": 30,
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "dispatchGraceMinutes": {
          "default": 10,
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        }
      },
      "required": [
        "dryRun",
        "maxParallelWorkers",
        "maxRetries",
        "maxNewIssues",
        "workerTimeoutMinutes",
        "dispatchGraceMinutes"
      ],
      "additionalProperties": false
    },
    "llm": {
      "type": "object",
      "properties": {
        "provider": {
          "default": "mock",
          "type": "string",
          "enum": [
            "mock",
            "openai"
          ]
        },
        "model": {
          "default": "gpt-4.1-mini",
          "type": "string",
          "minLength": 1
        },
        "reasoningEffort": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "none",
                "minimal",
                "low",
                "medium",
                "high",
                "xhigh"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "maxOutputTokens": {
          "default": 4000,
          "type": "integer",
          "minimum": 256,
          "maximum": 16000
        },
        "timeoutSeconds": {
          "default": 60,
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "maxCalls": {
          "default": 1,
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      },
      "required": [
        "provider",
        "model",
        "reasoningEffort",
        "maxOutputTokens",
        "timeoutSeconds",
        "maxCalls"
      ],
      "additionalProperties": false
    },
    "workers": {
      "type": "object",
      "properties": {
        "test": {
          "type": "object",
          "properties": {
            "enabled": {
              "default": true,
              "type": "boolean"
            },
            "operation": {
              "default": "sha256",
              "type": "string",
              "enum": [
                "sha256",
                "fail",
                "blocked"
              ]
            }
          },
          "required": [
            "enabled",
            "operation"
          ],
          "additionalProperties": false
        },
        "coding": {
          "default": false,
          "type": "boolean",
          "const": false
        },
        "review": {
          "default": false,
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "test",
        "coding",
        "review"
      ],
      "additionalProperties": false
    },
    "reporting": {
      "type": "object",
      "properties": {
        "persistDecisions": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": [
        "persistDecisions"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "harness",
    "manager",
    "autonomy",
    "execution",
    "llm",
    "workers",
    "reporting"
  ],
  "additionalProperties": false
}
