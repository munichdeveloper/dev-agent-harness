{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contractVersion": {
      "type": "string",
      "const": "3.0"
    },
    "executionId": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "worker": {
      "type": "string",
      "const": "codex"
    },
    "task": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:/#._-]{0,199}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "acceptanceCriteria": {
          "minItems": 1,
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "contextReferences": {
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1000
          }
        }
      },
      "required": [
        "id",
        "version",
        "description",
        "acceptanceCriteria",
        "contextReferences"
      ],
      "additionalProperties": false
    },
    "allowedActions": {
      "type": "array",
      "prefixItems": [
        {
          "type": "string",
          "const": "edit_workspace"
        },
        {
          "type": "string",
          "const": "run_commands"
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "baseSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "model": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9._-]{1,100}$"
    },
    "effort": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "xhigh"
      ]
    },
    "limits": {
      "type": "object",
      "properties": {
        "timeoutMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "maxFiles": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "maxPatchBytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 5000000
        }
      },
      "required": [
        "timeoutMinutes",
        "maxFiles",
        "maxPatchBytes"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contractVersion",
    "executionId",
    "worker",
    "task",
    "allowedActions",
    "baseSha",
    "model",
    "effort",
    "limits"
  ],
  "additionalProperties": false
}
